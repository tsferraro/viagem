# Backups locais (gerados pelo deploy.sh) ficam fora do repo
/.skill-backups/

# Builds temporários
/tmp-build/
*.tmp.html

# data.json de drafts (não publicáveis)
data-draft*.json
.draft-*.json

# Entregáveis gerados pela skill destination-scout
# .docx é intermediário (regenerável do .md) · ignorado em qualquer lugar
*.docx
# .pdf solto é ignorado, MAS as entregas versionadas vivem em entregas/ (liberadas abaixo)
*.pdf
!/entregas/**

# Editor cruft
.DS_Store
.idea/
.vscode/
*.swp

# Python bytecode
__pycache__/
*.pyc
